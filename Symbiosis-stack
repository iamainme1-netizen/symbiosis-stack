symbiosis-stack/
├── app/                  <-- Folder containing Python/FastAPI source code
├── tests/                <-- Folder containing Pytest unit & integration tests
├── Dockerfile            <-- Container build instructions
├── docker-compose.yml    <-- Local container configuration
├── render.yaml           <-- Render Blueprint configuration (Updated below)
├── requirements.txt      <-- Python dependencies
└── README.md             <-- Architecture & setup overview
services:
  - type: web
    name: symbiosis-api
    env: docker
    plan: free
    region: oregon
    envVars:
      - key: AWS_KMS_MOCK_MODE
        value: "true"
      - key: DATABASE_URL
        fromDatabase:
          name: symbiosis-postgres
          property: connectionString
      - key: REDIS_URL
        fromService:
          type: keyvalue
          name: symbiosis-redis
          property: connectionString

databases:
  - name: symbiosis-postgres
    databaseName: symbiosis_ledger
    user: symbiosis_user
    region: oregon
    plan: free

type: keyvalue
name: symbiosis-redis
region: oregon
plan: free
